"""
[PREFIX]

###
<Task>
Predict wind power generation (MW) from meteorological forecast data.

###
<Features>
[FEATURES]

###
<Examples>
[EXAMPLES]
[SUFFIX]
"""

@evaluate.run
def evaluate(data: dict):
    """
    Evaluate the feature transformations on wind power prediction task.

    New workflow:
    1. Extract single grid template (11 columns)
    2. Apply LLM's feature engineering to template
    3. Apply engineered template to all 4 grids
    4. Merge all grids + time features
    5. Train LGBM with K-Fold CV

    Uses Wind project's BaseLGBM with time-series K-Fold CV.
    """
    import sys
    from pathlib import Path
    import pandas as pd
    import numpy as np
    from sklearn.model_selection import KFold
    from sklearn.metrics import mean_squared_error

    # Add Wind project to Python path (modify this path on your server)
    wind_project_path = '/data/cqj-project/wind-power-forecast-mlflow-1'
    if wind_project_path not in sys.path:
        sys.path.insert(0, wind_project_path)

    # Add LLM-FE utils to path
    llmfe_path = '/data/cqj-project/LLM-FE/LLMFE'
    if llmfe_path not in sys.path:
        sys.path.insert(0, llmfe_path)

    from core.models.base_lgbm import BaseLGBM
    from utils.grid_template import (
        extract_grid_template,
        apply_template_to_grid,
        merge_all_grids
    )

    # Load data
    # inputs from LLM-FE is template (11 cols without grid prefix)
    # We need to reload the full 26-col data for applying to all grids
    template_inputs, outputs = data['inputs'], data['outputs']

    # Detect weather source from template column names
    # template has columns like: wind_speed_10m, wind_speed_80m (gfs/icon), etc.
    weather_source = None
    if 'wind_speed_80m' in template_inputs.columns:
        if 'wind_speed_180m' in template_inputs.columns:
            weather_source = 'icon_global'
        else:
            weather_source = 'gfs_global'
    else:
        weather_source = 'ecmwf_ifs025'

    # Re-load the full multi-grid data from CSV
    # This ensures we always have access to all 4 grids
    import os
    data_dir = '/data/cqj-project/LLM-FE/LLMFE/data'
    data_path = os.path.join(data_dir, f'windpower_SD_W_B_{weather_source}.csv')

    if not os.path.exists(data_path):
        # Fallback to current directory
        data_path = f'./data/windpower_SD_W_B_{weather_source}.csv'

    full_df = pd.read_csv(data_path)

    # Extract features and target (last column)
    target_col = full_df.columns[-1]  # 'power' or 'target'
    full_inputs = full_df.drop(columns=[target_col])
    full_outputs = full_df[target_col]

    # Verify shape matches
    assert len(full_inputs) == len(template_inputs), f"Data length mismatch: {len(full_inputs)} vs {len(template_inputs)}"

    # === Step 1: Template is already provided by LLM-FE ===
    # template_inputs: 11 columns (5 weather + 6 time features)
    # No need to extract, it's already the template
    print(f"[DEBUG] template_inputs shape: {template_inputs.shape}")
    print(f"[DEBUG] template_inputs columns: {template_inputs.columns.tolist()}")

    # === Step 2: Apply LLM's feature engineering to template ===
    engineered_template = modify_features(template_inputs)
    # engineered_template: 11 + M columns (original + new features)
    print(f"[DEBUG] engineered_template shape: {engineered_template.shape}")
    print(f"[DEBUG] engineered_template columns: {engineered_template.columns.tolist()}")

    # === Step 3: Apply engineered template to all 4 grids ===
    all_grids_features = []

    for grid_id in [1, 2, 3, 4]:
        grid_features = apply_template_to_grid(
            template_df=engineered_template,
            original_inputs=full_inputs,  # Use full 26-col data
            grid_id=grid_id,
            modify_features_func=modify_features,
            source=None  # Auto-detect
        )
        all_grids_features.append(grid_features)

    # === Step 4: Extract time features (global, not grid-specific) ===
    time_features = full_inputs[['hour_sin', 'hour_cos',
                                 'day_of_week_sin', 'day_of_week_cos',
                                 'month_sin', 'month_cos']]

    # === Step 5: Merge all grids + time features ===
    X = merge_all_grids(all_grids_features, time_features)

    # Convert y to pandas Series if it's numpy array (IMPORTANT for BaseLGBM compatibility)
    if isinstance(outputs, np.ndarray):
        y = pd.Series(outputs, index=X.index, name='power')
    else:
        y = outputs

    # Encode categorical columns if any
    for col in X.columns:
        if X[col].dtype == 'object' or X[col].dtype.name == 'string':
            X[col] = pd.Categorical(X[col]).codes

    # Handle missing values and infinite values
    X = X.replace([np.inf, -np.inf], np.nan)
    X = X.fillna(0)

    # Time-series K-Fold CV (no shuffle to preserve temporal order)
    kf = KFold(n_splits=4, shuffle=False)
    scores = []

    for train_idx, test_idx in kf.split(X, y):
        X_train, X_test = X.iloc[train_idx], X.iloc[test_idx]
        y_train, y_test = y.iloc[train_idx], y.iloc[test_idx]  # Use .iloc for Series

        # Use Wind project's BaseLGBM with faster training params
        model = BaseLGBM(
            model_name='llmfe_eval',
            weather_source='combined',
            params={
                'objective': 'regression',
                'metric': 'rmse',
                'learning_rate': 0.03,
                'num_leaves': 31,
                'max_depth': 8,
                'min_child_samples': 50,
                'feature_fraction': 0.9,
                'bagging_fraction': 0.8,
                'bagging_freq': 5,
                'reg_alpha': 0.1,
                'reg_lambda': 0.1,
                'verbose': -1
            }
        )

        try:
            # Train using Wind project's training method
            model.train(
                X_train=X_train,
                y_train=y_train,
                X_val=X_test,
                y_val=y_test,
                num_boost_round=500,
                early_stopping_rounds=50
            )

            # Predict and calculate RMSE
            y_pred = model.predict(X_test)
            rmse = np.sqrt(mean_squared_error(y_test, y_pred))
            scores.append(-rmse)  # Negative for maximization

        except Exception as e:
            # If training fails, return a very bad score
            print(f"Training error: {e}")
            scores.append(-999999)

    # Return average score
    avg_score = np.mean(scores)
    # IMPORTANT: Always return the ORIGINAL template (not engineered)
    # This ensures LLM always has access to all original features
    # even if previous samples deleted some columns
    # We need to extract template from full_inputs to get original columns
    original_template = extract_grid_template(full_inputs, grid_id=1, source=weather_source)
    return avg_score, original_template, outputs


@equation.evolve
def modify_features(df_input) -> pd.DataFrame:
    """
    Feature engineering for wind power prediction.

    IMPORTANT: Input is from a SINGLE grid point with simplified column names:
    - wind_speed_10m (NOT ecmwf_ifs025_grid1_wind_speed_10m)
    - wind_direction_10m
    - relative_humidity_2m
    - pressure_msl
    - surface_pressure
    - hour_sin, hour_cos
    - day_of_week_sin, day_of_week_cos
    - month_sin, month_cos

    Your features will be automatically applied to all 4 grids.

    Thought 1: Wind power is proportional to wind speed cubed, so adding polynomial features of wind speed should improve prediction.
    New Feature 1: wind_speed_cubed | wind_speed_cubed = (wind_speed_10m ** 3)
    """
    import pandas as pd
    import numpy as np

    df_output = df_input.copy()

    # Add cubic wind speed feature (power law relationship)
    df_output['wind_speed_cubed'] = df_input['wind_speed_10m'] ** 3

    return df_output
